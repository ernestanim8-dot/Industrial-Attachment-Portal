# Backend Environment Configuration
PORT=5000

# Supabase PostgreSQL Configuration
# Create a free project at https://supabase.com and copy credentials from Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT Secret for authentication tokens (Generate a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Allowed frontend origins for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.vercel.app

# Cloudinary credentials for report attachment uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Staff Registration Access Code (Required for admin and supervisor registration)
STAFF_ACCESS_CODE=TTU-STAFF-2026

# SMS Gateway Configuration (e.g. Arkesel, Hubtel, mNotify, Twilio)
# SMS_API_KEY=your_sms_api_key
# SMS_SENDER_ID=TTU-PORTAL

# SMTP Email Configuration (e.g., Brevo, Resend, or SendGrid)
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="TTU Industrial Attachment" <noreply@ttu.edu.gh>

